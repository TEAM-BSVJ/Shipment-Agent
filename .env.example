# =============================================================================
# Logistics Bottleneck Resolution Agent — Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in your values:
#   cp .env.example .env
# =============================================================================

# ---- Application ----
APP_ENV=development                # development | staging | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ---- Database ----
# For Docker Compose: use the internal service name "db"
# For local dev: use localhost with your PostgreSQL port
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/logistics_db

# ---- Evolus AI Platform ----
EVOLUS_BASE_URL=https://api.evolus.ai
EVOLUS_API_KEY=                    # Your Evolus API key (leave empty for mock mode)
EVOLUS_APPLICATION_ID=             # Your Evolus Application ID
EVOLUS_MODEL=own/qwen3.8-27b      # Model checkpoint to use
EVOLUS_MOCK_MODE=false             # Set to "true" to force mock responses

# ---- CORS ----
# Comma-separated or JSON array of allowed origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---- Document Processing ----
MAX_UPLOAD_SIZE_BYTES=10485760     # 10 MB

# ---- Notifications ----
NOTIFICATION_PROVIDER=mock         # mock | smtp | webhook

# ---- Docker Compose Overrides ----
POSTGRES_PORT=5433                 # Host port mapped to container's 5432
